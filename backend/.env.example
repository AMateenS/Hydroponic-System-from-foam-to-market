PORT=4000
MONGO_URI=
# Must be IDENTICAL to JWT_SECRET in web/.env.local
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Frontend origin(s), comma separated. The first one is used in emails and payment redirects
CLIENT_URL=http://localhost:3000
NODE_ENV=development
# Your Firebase project id. Same value as NEXT_PUBLIC_FIREBASE_PROJECT_ID in web/.env.local
FIREBASE_PROJECT_ID=
# Emails that become ADMIN automatically after they sign up, verify their email and log in
# at /admin/login. Comma separated. More admins can be added later in Admin > Users.
ADMIN_EMAILS=
# Gmail address + 16-character App Password (used for order and contact emails)
EMAIL_USER=
EMAIL_PASS=

# ---- Online card payments (Stripe). Leave STRIPE_SECRET_KEY empty to disable card payment ----
# Test key from https://dashboard.stripe.com/test/apikeys  (starts with sk_test_)
STRIPE_SECRET_KEY=
# Only needed if you use webhooks (see README). Starts with whsec_
STRIPE_WEBHOOK_SECRET=
# pkr by default. If Stripe rejects it for your account, use usd
STRIPE_CURRENCY=pkr

# Products created before stock tracking existed get this stock once, at first start
INITIAL_STOCK_FOR_EXISTING_PRODUCTS=50

# Production only, when frontend and API are on sibling subdomains (e.g. .example.com)
# COOKIE_DOMAIN=
